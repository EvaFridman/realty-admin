{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "./dist",
      "rootDir": "./",
  
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "erasableSyntaxOnly": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
  
      "types": ["node", "jest"]
    },
    "include": ["src", "database/models", "types", "server.ts", "logger.ts"],
    "exclude": ["node_modules", "dist", "database/migrations", "database/seeders"]
}